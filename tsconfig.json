{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "target": "ES2021",
        "outDir": "./dist",
        "rootDir": "./src",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "types": ["node", "jest"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
